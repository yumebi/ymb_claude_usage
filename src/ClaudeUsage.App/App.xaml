<Application x:Class="ClaudeUsage.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- YMB共通トークン。値の正本は ymb-ui 側にあるので、
                     ここを直接編集せず正本を直してから配り直すこと。
                     暗黙の TextBlock / ToolTip / Button スタイルも共通側にある。 -->
                <ResourceDictionary Source="Themes/YmbTheme.xaml" />
                <ResourceDictionary Source="Themes/YmbTheme.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ここから下はマージ辞書より優先される(直接定義が勝つ)。

                 アクセントはYMB共通の赤(#C3002F)ではなくAnthropicのブランド色のまま。
                 Claudeの使用量を見るアプリなので、この色自体に意味がある。
                 揃えるのは面・文字・フォント・角丸とトークン名までとする。 -->
            <SolidColorBrush x:Key="YmbAccentBrush" Color="#D97757" />
            <SolidColorBrush x:Key="YmbAccentHoverBrush" Color="#E4917B" />

            <!-- 使用量バーの地。このアプリ固有。 -->
            <SolidColorBrush x:Key="BarBack" Color="#3A3A4A" />

            <!-- 複数プロバイダー表示用のダークタブ -->
            <Style x:Key="DarkTabControl" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,6,0,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Background="Transparent" />
                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="SelectedContent" />
                                </Border>
                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DarkTabItem" TargetType="TabItem">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="bd" CornerRadius="{StaticResource YmbRadiusSm}" Padding="10,3" Margin="0,0,4,0"
                                    Background="Transparent">
                                <ContentPresenter ContentSource="Header" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource YmbSurfaceBrush}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource YmbOverlayHoverBrush}" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
