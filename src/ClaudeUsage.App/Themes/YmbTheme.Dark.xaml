<!--
  YMB 共通デザイントークン (WPF 系) — ダークテーマの面・文字・意味色
  正本: ymb-ui/YmbTheme.Dark.xaml
  YmbTheme.xaml と一緒にマージして使う。キー名は Light 版と完全に対応させる。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 面 ===== -->
    <!-- 半透明ウィンドウを使うアプリ (デスクトップカレンダー等) は
         YmbBgBrush ではなく YmbBgTranslucentBrush を使う。 -->
    <SolidColorBrush x:Key="YmbBgBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="YmbBgTranslucentBrush" Color="#F21E1E1E" />
    <SolidColorBrush x:Key="YmbSurfaceBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="YmbSurfaceAltBrush" Color="#252528" />
    <SolidColorBrush x:Key="YmbBorderBrush" Color="#3A3A40" />
    <SolidColorBrush x:Key="YmbBorderSoftBrush" Color="#2A2A2E" />
    <SolidColorBrush x:Key="YmbRowHoverBrush" Color="#33333A" />
    <!-- 半透明のホバー膜。面色に載せる用途。 -->
    <SolidColorBrush x:Key="YmbOverlayHoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="YmbOverlayPressBrush" Color="#44FFFFFF" />

    <!-- ===== 文字 ===== -->
    <SolidColorBrush x:Key="YmbFgBrush" Color="#EAEAEA" />
    <SolidColorBrush x:Key="YmbFgDimBrush" Color="#9A9AA4" />
    <SolidColorBrush x:Key="YmbFgMutedBrush" Color="#888888" />

    <!-- ===== 意味色 ===== -->
    <SolidColorBrush x:Key="YmbDangerBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="YmbGoodBrush" Color="#4CAF50" />
    <SolidColorBrush x:Key="YmbWarningBrush" Color="#E0A800" />
    <SolidColorBrush x:Key="YmbLinkBrush" Color="#4FC1FF" />

</ResourceDictionary>
