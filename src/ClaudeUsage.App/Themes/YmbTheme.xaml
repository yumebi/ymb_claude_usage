<!--
  YMB 共通デザイントークン (WPF 系) — テーマ非依存の部分
  正本: ymb-ui/YmbTheme.xaml
  各アプリは Themes/ 配下にコピーし、App.xaml でマージする:

      <Application.Resources>
          <ResourceDictionary>
              <ResourceDictionary.MergedDictionaries>
                  <ResourceDictionary Source="Themes/YmbTheme.xaml" />
                  <ResourceDictionary Source="Themes/YmbTheme.Dark.xaml" />
              </ResourceDictionary.MergedDictionaries>
          </ResourceDictionary>
      </Application.Resources>

  ここにはテーマ(明暗)で変わらない値だけを置く。
  面の色・文字色・意味色は YmbTheme.Dark.xaml / YmbTheme.Light.xaml 側。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== ブランド ===== -->
    <Color x:Key="YmbAccentColor">#C3002F</Color>
    <Color x:Key="YmbAccentHoverColor">#E0103F</Color>
    <SolidColorBrush x:Key="YmbAccentBrush" Color="{StaticResource YmbAccentColor}" />
    <SolidColorBrush x:Key="YmbAccentHoverBrush" Color="{StaticResource YmbAccentHoverColor}" />
    <SolidColorBrush x:Key="YmbAccentFgBrush" Color="#FFFFFF" />

    <!-- ===== 文字組み ===== -->
    <!-- Windows 専用。Segoe UI で欧文、日本語は Yu Gothic UI へフォールバック。 -->
    <FontFamily x:Key="YmbFontFamily">Segoe UI, Yu Gothic UI, Meiryo</FontFamily>
    <FontFamily x:Key="YmbFontFamilyMono">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="YmbFontSizeH1">18</sys:Double>
    <sys:Double x:Key="YmbFontSizeBase">13</sys:Double>
    <sys:Double x:Key="YmbFontSizeLabel">12</sys:Double>
    <sys:Double x:Key="YmbFontSizeSmall">11</sys:Double>

    <!-- ===== 形 ===== -->
    <CornerRadius x:Key="YmbRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="YmbRadiusMd">6</CornerRadius>

    <!-- ===== 余白 ===== -->
    <Thickness x:Key="YmbPadButton">10,5</Thickness>
    <Thickness x:Key="YmbPadInput">6,4</Thickness>
    <Thickness x:Key="YmbPadPanel">12,10</Thickness>

    <!-- ===== 共通コントロール =====
         面・文字の色は YmbTheme.Dark.xaml / .Light.xaml 側にあり、
         この辞書からは見えない。必ず DynamicResource で引くこと。
         StaticResource だと兄弟辞書のキーを解決できずパースに失敗し、
         実行時にテーマ辞書を差し替えるアプリ(デスクトップカレンダー)でも追従しなくなる。 -->

    <!-- 意図的に Foreground を指定しない。
         暗黙の TextBlock スタイルは ContentPresenter が文字列から生成する
         TextBlock にも効き、スタイルのSetterは継承値に勝つ。ここで前景色を固定すると
         ComboBox のドロップダウンやツールチップ(既定は明るい地)まで明色の文字になり、
         白地に白文字で読めなくなる。
         前景色は Window 側に置いて継承させること。ポップアップの中では
         そのコントロール自身の Foreground が継承されるので破綻しない。 -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource YmbFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource YmbFontSizeBase}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource YmbSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource YmbFgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource YmbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontFamily" Value="{StaticResource YmbFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource YmbFontSizeSmall}" />
    </Style>

    <!-- 主要操作。塗りつぶし。 -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource YmbAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource YmbAccentFgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource YmbAccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource YmbFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource YmbFontSizeLabel}" />
        <Setter Property="Padding" Value="{StaticResource YmbPadButton}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource YmbRadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource YmbAccentHoverBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource YmbAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 副次操作。枠線のみ。 -->
    <Style x:Key="YmbSecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource YmbFgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource YmbBorderBrush}" />
    </Style>

    <!-- 破壊的操作。アクセントと同じ赤系なので、色ではなく「枠線のみ」で主要操作と区別する。 -->
    <Style x:Key="YmbDangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource YmbDangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource YmbDangerBrush}" />
    </Style>

    <!-- ヘッダー等に置く小さいアイコンボタン。地は透明で、ホバー時だけ膜を敷く。 -->
    <Style x:Key="YmbIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource YmbFgDimBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="22" />
        <Setter Property="FontFamily" Value="{StaticResource YmbFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource YmbFontSizeLabel}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource YmbRadiusSm}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource YmbOverlayPressBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
